# Copy to backend/.env. Never commit real secrets.
ENVIRONMENT=development          # anything else enforces a real JWT_SECRET
JWT_SECRET=                      # openssl rand -hex 32  (required outside development)
DATABASE_URL=sqlite:///./nariway.db   # pilot: postgresql://nariway:nariway@localhost:5432/nariway
ADMIN_EMAILS=["you@example.com"] # accounts registered with these emails become moderators
PUBLIC_WEB_URL=http://localhost:5173  # base URL used in share links
CORS_ORIGINS=["http://localhost:5173"]
PILOT_CITY=Rourkela
ROUTING_PROVIDER_URL=            # self-hosted OSRM, e.g. http://localhost:5000. Empty = labelled demo routes
GEOCODER_URL=                    # Nominatim-compatible. Empty = small demo gazetteer
